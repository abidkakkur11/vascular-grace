{
    "key": "group_template_media",
    "title": "Page \u2014 Media Template Fields",
    "fields": [
        {
            "key": "field_media_tab_hero",
            "label": "Hero Section",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_media_hero_title",
            "label": "Hero Title (HTML allowed)",
            "name": "media_hero_title",
            "type": "textarea",
            "rows": 3,
            "default_value": "Clinical insights, videos and \n<span class=\"hero-title-accent\">news features.</span>",
            "instructions": "Supports span with hero-title-accent class for accent color. Use newlines for line breaks."
        },
        {
            "key": "field_media_hero_subtitle",
            "label": "Hero Subtitle",
            "name": "media_hero_subtitle",
            "type": "textarea",
            "rows": 3,
            "default_value": "Watch patient awareness shorts, in-depth surgical talks, and explore recent media coverage with Dr. S Srikanth Raju."
        },
        {
            "key": "field_media_tab_shorts",
            "label": "Short-Form Videos (Reels / Shorts)",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_media_shorts",
            "label": "Shorts & Reels",
            "name": "media_shorts",
            "type": "repeater",
            "min": 0,
            "max": 20,
            "layout": "block",
            "button_label": "Add Short / Reel",
            "sub_fields": [
                {
                    "key": "field_short_title",
                    "label": "Title",
                    "name": "short_title",
                    "type": "text",
                    "placeholder": "Early Signs of Varicose Veins You Shouldn't Ignore",
                    "required": 1
                },
                {
                    "key": "field_short_url",
                    "label": "Video Link (YouTube Shorts / Instagram Reel / Direct URL)",
                    "name": "short_url",
                    "type": "url",
                    "placeholder": "https://www.youtube.com/shorts/..."
                },
                {
                    "key": "field_short_thumb",
                    "label": "Custom Thumbnail Image (Optional \u2014 if blank, default video thumbnail is used)",
                    "name": "short_thumb",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium"
                }
            ]
        },
        {
            "key": "field_media_tab_youtube",
            "label": "Educational YouTube Videos",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_media_youtube",
            "label": "Long-Form Videos",
            "name": "media_youtube",
            "type": "repeater",
            "min": 0,
            "max": 20,
            "layout": "block",
            "button_label": "Add YouTube Video",
            "sub_fields": [
                {
                    "key": "field_yt_title",
                    "label": "Video Title",
                    "name": "yt_title",
                    "type": "text",
                    "placeholder": "Modern Management of Peripheral Arterial Disease (PAD)",
                    "required": 1
                },
                {
                    "key": "field_yt_url",
                    "label": "YouTube Video URL",
                    "name": "yt_url",
                    "type": "url",
                    "placeholder": "https://www.youtube.com/watch?v=..."
                },
                {
                    "key": "field_yt_thumb",
                    "label": "Custom Thumbnail Image (Optional \u2014 if blank, YouTube thumbnail is fetched automatically)",
                    "name": "yt_thumb",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium"
                }
            ]
        },
        {
            "key": "field_media_tab_news",
            "label": "Press & News Highlights",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_media_news",
            "label": "News Articles",
            "name": "media_news",
            "type": "repeater",
            "min": 0,
            "max": 20,
            "layout": "block",
            "button_label": "Add News Article",
            "sub_fields": [
                {
                    "key": "field_news_title",
                    "label": "Article Headline",
                    "name": "news_title",
