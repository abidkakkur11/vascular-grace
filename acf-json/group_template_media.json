                    "rows": 2,
                    "placeholder": "Minimally Invasive Techniques Transforming Diabetic Foot Management in Telangana",
                    "required": 1
                },
                {
                    "key": "field_news_url",
                    "label": "Article / Press URL",
                    "name": "news_url",
                    "type": "url",
                    "placeholder": "https://..."
                },
                {
                    "key": "field_news_thumb",
                    "label": "Custom Thumbnail / Article Image",
                    "name": "news_thumb",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-templates/template-media.php"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
